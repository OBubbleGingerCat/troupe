{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.local/schemas/npm-cache-v1.json",
  "title": "Troupe diagnostics npm cache identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockSha256",
    "nodeMajor",
    "nodeVersion",
    "npmVersion",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lockSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodeMajor": {
      "type": "integer",
      "minimum": 1
    },
    "nodeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "npmVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "integrity",
          "path",
          "resolved",
          "sha512",
          "size"
        ],
        "properties": {
          "integrity": {
            "type": "string",
            "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
          },
          "path": {
            "type": "string",
            "pattern": "^_cacache/content-v2/sha512/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{124}$"
          },
          "resolved": {
            "type": "string",
            "pattern": "^https://registry\\.npmjs\\.org/"
          },
          "sha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
