{
  "schema": "troupe.diagnostics.rust-quality.v1",
  "mode": "all",
  "options": {
    "locked": true,
    "offline": true,
    "deny_warnings": true
  },
  "stages": [
    {
      "name": "fmt",
      "argv": [
        "cargo",
        "fmt",
        "--check",
        "--all",
        "--manifest-path",
        "rust/Cargo.toml"
      ]
    },
    {
      "name": "check",
      "argv": [
        "cargo",
        "check",
        "--locked",
        "--offline",
        "--manifest-path",
        "rust/Cargo.toml",
        "--workspace",
        "--all-targets",
        "--all-features"
      ]
    },
    {
      "name": "clippy",
      "argv": [
        "cargo",
        "clippy",
        "--locked",
        "--offline",
        "--manifest-path",
        "rust/Cargo.toml",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ]
    },
    {
      "name": "test",
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "--manifest-path",
        "rust/Cargo.toml",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--no-fail-fast"
      ]
    }
  ]
}
