{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.local/schemas/diagnostics-final-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attempt_id", "identity", "cache", "children", "reports", "result"],
  "properties": {
    "schema": { "const": "troupe.diagnostics.final-evidence.v1" },
    "attempt_id": { "$ref": "#/$defs/uuid" },
    "identity": { "$ref": "#/$defs/identity" },
    "cache": { "$ref": "#/$defs/cache" },
    "children": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        { "$ref": "#/$defs/child1" },
        { "$ref": "#/$defs/child2" },
        { "$ref": "#/$defs/child3" },
        { "$ref": "#/$defs/child4" },
        { "$ref": "#/$defs/child5" },
        { "$ref": "#/$defs/child6" },
        { "$ref": "#/$defs/child7" },
        { "$ref": "#/$defs/child8" },
        { "$ref": "#/$defs/child9" },
        { "$ref": "#/$defs/child10" },
        { "$ref": "#/$defs/child11" }
      ],
      "items": false
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performance", "wheel"],
      "properties": {
        "performance": { "$ref": "#/$defs/performanceReport" },
        "wheel": { "$ref": "#/$defs/wheelReport" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result_sha256"],
      "properties": {
        "status": { "const": "passed" },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_design_sha256", "diagnostics_design_sha256", "plan_sha256", "validator_sha256", "review_record_sha256", "integration_sha"],
      "properties": {
        "actor_design_sha256": { "$ref": "#/$defs/sha256" },
        "diagnostics_design_sha256": { "$ref": "#/$defs/sha256" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "validator_sha256": { "$ref": "#/$defs/sha256" },
        "review_record_sha256": { "$ref": "#/$defs/sha256" },
        "integration_sha": { "$ref": "#/$defs/commit" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm_manifest_sha256", "playwright_identity_sha256", "perfetto_identity_sha256", "performance_report_cache_sha256", "wheel_report_cache_sha256", "aggregate_sha256"],
      "properties": {
        "npm_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "playwright_identity_sha256": { "$ref": "#/$defs/sha256" },
        "perfetto_identity_sha256": { "$ref": "#/$defs/sha256" },
        "performance_report_cache_sha256": { "$ref": "#/$defs/sha256" },
        "wheel_report_cache_sha256": { "$ref": "#/$defs/sha256" },
        "aggregate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "childBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "argv", "exit_code", "stdout_sha256", "stderr_sha256", "result_sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "maximum": 11 },
        "name": { "type": "string", "minLength": 1 },
        "argv": { "$ref": "#/$defs/argv" },
        "exit_code": { "const": 0 },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "child1": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 1 }, "name": { "const": "linux-release" } } },
    "child2": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 2 }, "name": { "const": "diagnostics-e2e" } } },
    "child3": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 3 }, "name": { "const": "O00" } } },
    "child4": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 4 }, "name": { "const": "O01" } } },
    "child5": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 5 }, "name": { "const": "O02" } } },
    "child6": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 6 }, "name": { "const": "O03" } } },
    "child7": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 7 }, "name": { "const": "O04" } } },
    "child8": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 8 }, "name": { "const": "V11" } } },
    "child9": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 9 }, "name": { "const": "plan" } } },
    "child10": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 10 }, "name": { "const": "ownership" } } },
    "child11": { "$ref": "#/$defs/childBase", "properties": { "index": { "const": 11 }, "name": { "const": "generated-diff" } } },
    "performanceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_sha256", "cache_sha256"],
      "properties": {
        "path": { "const": "V05-performance-raw.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "cache_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "wheelReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_sha256", "cache_sha256"],
      "properties": {
        "path": { "const": "V07-wheel-report.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "cache_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
