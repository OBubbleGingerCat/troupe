{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://troupe.local/schemas/diagnostics-wheel-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "contract",
    "build",
    "cache",
    "artifacts",
    "exporter_size",
    "smoke",
    "result"
  ],
  "properties": {
    "schema": { "const": "troupe.diagnostics.wheel-report.v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_design_sha256",
        "diagnostics_design_sha256",
        "plan_sha256",
        "validator_sha256",
        "review_record_sha256",
        "integration_sha"
      ],
      "properties": {
        "actor_design_sha256": { "$ref": "#/$defs/sha256" },
        "diagnostics_design_sha256": { "$ref": "#/$defs/sha256" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "validator_sha256": { "$ref": "#/$defs/sha256" },
        "review_record_sha256": { "$ref": "#/$defs/sha256" },
        "integration_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_sha256", "report_schema_sha256"],
      "properties": {
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "report_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline",
        "build_system",
        "builder_image",
        "manylinux",
        "target",
        "smoke_modes",
        "forbidden_tools",
        "wheel_builds"
      ],
      "properties": {
        "offline": { "const": true },
        "build_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires", "build_backend"],
          "properties": {
            "requires": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "const": "maturin==1.14.1" }
            },
            "build_backend": { "const": "maturin" }
          }
        },
        "builder_image": {
          "const": "ghcr.io/pyo3/maturin@sha256:2665227312dd1eab1c29c70a001dc8aac53155a2d048bede3b2df7f1691c8e38"
        },
        "manylinux": { "const": "2_17" },
        "target": { "const": "x86_64-unknown-linux-gnu" },
        "smoke_modes": { "$ref": "#/$defs/smokeModes" },
        "forbidden_tools": { "$ref": "#/$defs/forbiddenTools" },
        "wheel_builds": { "const": 1 }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "identity_sha256"],
      "properties": {
        "requirements": { "type": "array", "maxItems": 0 },
        "identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "sdist", "wheel", "native"],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "sdist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "sha256", "bytes", "regular_members"],
          "properties": {
            "filename": { "type": "string", "pattern": "^troupe-0\\.1\\.0\\.tar\\.gz$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1 },
            "regular_members": { "type": "integer", "minimum": 1 }
          }
        },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "sha256_before_smoke",
            "sha256_after_smoke",
            "bytes_before_smoke",
            "bytes_after_smoke",
            "members"
          ],
          "properties": {
            "filename": { "type": "string", "pattern": "^troupe-0\\.1\\.0-.+\\.whl$" },
            "sha256_before_smoke": { "$ref": "#/$defs/sha256" },
            "sha256_after_smoke": { "$ref": "#/$defs/sha256" },
            "bytes_before_smoke": { "type": "integer", "minimum": 1 },
            "bytes_after_smoke": { "type": "integer", "minimum": 1 },
            "members": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": { "$ref": "#/$defs/member" }
            }
          }
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256_before_smoke",
            "sha256_after_smoke",
            "bytes_before_smoke",
            "bytes_after_smoke",
            "elf_needed"
          ],
          "properties": {
            "path": { "type": "string", "pattern": "^troupe/_runtime(?:\\.[A-Za-z0-9_]+)*\\.so$" },
            "sha256_before_smoke": { "$ref": "#/$defs/sha256" },
            "sha256_after_smoke": { "$ref": "#/$defs/sha256" },
            "bytes_before_smoke": { "type": "integer", "minimum": 1 },
            "bytes_after_smoke": { "type": "integer", "minimum": 1 },
            "elf_needed": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "exporter_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "delta", "hard_limit"],
      "properties": {
        "before": { "$ref": "#/$defs/sizeArtifact" },
        "after": { "$ref": "#/$defs/sizeArtifact" },
        "delta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wheel_bytes", "native_bytes"],
          "properties": {
            "wheel_bytes": { "type": "integer" },
            "native_bytes": { "type": "integer" }
          }
        },
        "hard_limit": { "const": false }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "run_id",
        "installed_native_sha256",
        "installed_native_bytes",
        "active",
        "archive",
        "forbidden_tools",
        "production_imports"
      ],
      "properties": {
        "modes": { "$ref": "#/$defs/smokeModes" },
        "run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "installed_native_sha256": { "$ref": "#/$defs/sha256" },
        "installed_native_bytes": { "type": "integer", "minimum": 1 },
        "active": { "$ref": "#/$defs/uiSmoke" },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ui", "trace_bytes", "trace_sha256"],
          "properties": {
            "status": { "const": "passed" },
            "ui": { "$ref": "#/$defs/ui" },
            "trace_bytes": { "type": "integer", "minimum": 1 },
            "trace_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "forbidden_tools": { "$ref": "#/$defs/forbiddenTools" },
        "production_imports": { "const": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result_sha256"],
      "properties": {
        "status": { "const": "passed" },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "smokeModes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "const": "active" }, { "const": "archive" }],
      "items": false
    },
    "forbiddenTools": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "const": "node" },
        { "const": "nodejs" },
        { "const": "npm" },
        { "const": "npx" },
        { "const": "protoc" },
        { "const": "perfetto" },
        { "const": "trace_processor_shell" }
      ],
      "items": false
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "sizeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "wheel_sha256",
        "wheel_bytes",
        "native_sha256",
        "native_bytes"
      ],
      "properties": {
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "wheel_sha256": { "$ref": "#/$defs/sha256" },
        "wheel_bytes": { "type": "integer", "minimum": 1 },
        "native_sha256": { "$ref": "#/$defs/sha256" },
        "native_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html_bytes", "html_sha256", "assets"],
      "properties": {
        "html_bytes": { "type": "integer", "minimum": 1 },
        "html_sha256": { "$ref": "#/$defs/sha256" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/member" }
        }
      }
    },
    "uiSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ui"],
      "properties": {
        "status": { "const": "passed" },
        "ui": { "$ref": "#/$defs/ui" }
      }
    }
  }
}
